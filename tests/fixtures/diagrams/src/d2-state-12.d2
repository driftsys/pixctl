direction: right
header: State overview {shape: text; style.font-size: 15}
a: "Read input\nValidate fields\nRecord request" {shape: oval; style.font-size: 12}
b: "Prepare data\nApply policy\nStore result" {shape: oval; style.font-size: 12}
c: "Review output\nNotify client\nClose request" {shape: oval; style.font-size: 12}
d: Status {shape: oval; style.font-size: 12}
a -> b: accepted { style.font-size: 12}
b -> c: processed { style.font-size: 12}
c -> d: complete { style.font-size: 12}
legend: "Legend: normal path" {shape: text; style.font-size: 10}
