direction: down
header: Architecture overview {shape: text; style.font-size: 13}
a: "Read input\nValidate fields\nRecord request" {style.font-size: 10}
b: "Prepare data\nApply policy\nStore result" {style.font-size: 10}
c: "Review output\nNotify client\nClose request" {style.font-size: 10}
d: Status {style.font-size: 10}
a -> b: accepted {style.font-size: 10}
b -> c: processed {style.font-size: 10}
c -> d: complete {style.font-size: 10}
legend: "Legend: normal path" {shape: text; style.font-size: 8}
