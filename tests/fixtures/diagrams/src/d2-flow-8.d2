direction: right
header: Flow overview {shape: text; style.font-size: 11}
a: "Read input\nValidate fields\nRecord request" {style.font-size: 8}
b: "Prepare data\nApply policy\nStore result" {shape: diamond; style.font-size: 8}
c: "Review output\nNotify client\nClose request" {style.font-size: 8}
d: Status {style.font-size: 8}
a -> b: accepted {style.font-size: 8}
b -> c: processed {style.font-size: 8}
c -> d: complete {style.font-size: 8}
legend: "Legend: normal path" {shape: text; style.font-size: 8}
