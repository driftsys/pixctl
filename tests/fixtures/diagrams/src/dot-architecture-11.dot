digraph G {
 rankdir=LR;
 graph [dpi=96, fontname="Noto Sans", fontsize=10.5, labelloc=t, label="Architecture overview"];
 node [shape=box, fontname="Noto Sans", fontsize=8.25];
 edge [fontname="Noto Sans", fontsize=8.25];
 a [label="Read input\nValidate fields\nRecord request"];
 b [label="Prepare data\nApply policy\nStore result"];
 c [label="Review output\nNotify client\nClose request"];
 d [label="Status"];
 a -> b [label="accepted"]; b -> c [label="processed"]; c -> d [label="complete"];
 note [shape=note, fontsize=6.75, label="Legend: normal path"];
}
