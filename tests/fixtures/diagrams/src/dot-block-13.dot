digraph G {
 graph [dpi=96, fontname="Noto Sans", fontsize=12.0, labelloc=t, label="Block overview"];
 node [shape=box, fontname="Noto Sans", fontsize=9.75];
 edge [fontname="Noto Sans", fontsize=9.75];
 a [label="Read input\nValidate fields\nRecord request"];
 b [label="Prepare data\nApply policy\nStore result"];
 c [label="Review output\nNotify client\nClose request"];
 d [label="Status"];
 a -> b [label="accepted"]; b -> c [label="processed"]; c -> d [label="complete"];
 note [shape=note, fontsize=8.25, label="Legend: normal path"];
}
