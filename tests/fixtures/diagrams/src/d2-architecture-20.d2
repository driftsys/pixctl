direction: down
header: Architecture overview {shape: text; style.font-size: 23}
a: "Read input\nValidate fields\nRecord request" {style.font-size: 20}
b: "Prepare data\nApply policy\nStore result" {style.font-size: 20}
c: "Review output\nNotify client\nClose request" {style.font-size: 20}
d: Status {style.font-size: 20}
a -> b: accepted {style.font-size: 20}
b -> c: processed {style.font-size: 20}
c -> d: complete {style.font-size: 20}
legend: "Legend: normal path" {shape: text; style.font-size: 18}
