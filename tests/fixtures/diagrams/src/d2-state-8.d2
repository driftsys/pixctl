direction: right
header: State overview {shape: text; style.font-size: 11}
a: "Read input\nValidate fields\nRecord request" {shape: oval; style.font-size: 8}
b: "Prepare data\nApply policy\nStore result" {shape: oval; style.font-size: 8}
c: "Review output\nNotify client\nClose request" {shape: oval; style.font-size: 8}
d: Status {shape: oval; style.font-size: 8}
a -> b: accepted { style.font-size: 8}
b -> c: processed { style.font-size: 8}
c -> d: complete { style.font-size: 8}
legend: "Legend: normal path" {shape: text; style.font-size: 8}
